+// Explicit instantiation of the generic (non-SSE) vnl_sse<char> so that the
+// member functions are emitted and exported from this library.  In Debug
+// builds VNL_SSE_FORCE_INLINE is empty, so consumers reference these symbols
+// via __declspec(dllimport); without this instantiation the link fails with
+// unresolved external symbols (see ITK issue with vnl_sse<char>/<short> on
+// MSVC debug builds).
+//
+// The export override must be applied before vnl_sse.h is parsed: the class
+// template carries VNL_EXPORT and would otherwise be marked dllimport here.
+#include "vnl/vnl_export.h"
+#include "vnl_export_override.h"
+#include "vnl/vnl_sse.h"
+
+template class vnl_sse<char>;
